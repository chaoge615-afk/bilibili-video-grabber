# ============================================================
# video-grabber 环境配置（复制为 .env 并填入真实值）
# ============================================================

# ── 云 ASR 转写（兼容 multipart /audio/transcriptions 服务） ──
# 必填：请填写所选服务商的配置。
ASR_API_KEY=
ASR_API_URL=
ASR_MODEL=
ASR_TIMEOUT=300
ASR_MAX_FILE_MB=0

# ── 精炼（OpenAI Chat Completions 兼容接口，可选） ──
# 不配则 md 中只含完整转写，跳过精炼摘要
REFINE_API_KEY=
REFINE_API_URL=
REFINE_MODEL=

# ── B站 Cookie（可选，Netscape 格式文本或文件路径） ──
# 不配则部分公开视频仍可下载，需登录的视频会失败
BILIBILI_COOKIE=
